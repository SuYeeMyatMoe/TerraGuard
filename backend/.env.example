# Copy to backend/.env and fill in. Never commit .env. All keys stay on the backend.
# Supabase — required for operational records. No keys belong in the Next.js app.
SUPABASE_URL=https://your-project.supabase.co
# Use a modern sb_secret_ key (preferred) or the legacy service_role JWT; never anon/publishable.
SUPABASE_SECRET_KEY=
# NASA FIRMS (free, instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAI — incident briefings (Responses API, strict JSON schema)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Grafilab — field briefs (OpenAI-compatible, https://llm.grafilab.ai/v1). Leave model blank to auto-pick from /models.
GRAFILAB_API_KEY=
GRAFILAB_MODEL=
# Google Earth Engine — Earth View satellite/NDVI layers. Register the project first.
# Local development: .venv/bin/earthengine authenticate (Google sign-in on this machine).
GEE_PROJECT=
# Optional deployment service account JSON file path; keep the file outside Git.
GEE_SERVICE_ACCOUNT_JSON=
# Supabase — operational records (actions, incident_status, team_assignments). Optional:
# without these the backend stores records in backend/data/terraguard.db (SQLite).
# Use the secret / service-role key here only. Never put it in the Next.js app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
