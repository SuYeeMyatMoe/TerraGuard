# Copy to backend/.env and fill in. Never commit .env. All keys stay on the backend.
# NASA FIRMS (free, instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenAI — incident briefings (Responses API, strict JSON schema)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Grafilab — field briefs (OpenAI-compatible, https://llm.grafilab.ai/v1). Leave model blank to auto-pick from /models.
GRAFILAB_API_KEY=
GRAFILAB_MODEL=
# Google Earth Engine (optional context): project id and service-account key file path
GEE_PROJECT=
GEE_SERVICE_ACCOUNT_JSON=
