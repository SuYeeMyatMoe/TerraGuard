# Google Maps JavaScript API browser key (restrict to your origins + Maps JavaScript API only).
# Leave empty to use the MapLibre / OpenFreeMap fallback basemap.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional Map ID (required for Advanced Markers styling)
NEXT_PUBLIC_GOOGLE_MAP_ID=
# React Bits Pro registry authentication (CLI only; never use NEXT_PUBLIC_ here).
# Copy to .env.local and add your license key to install premium components.
REACTBITS_LICENSE_KEY=
